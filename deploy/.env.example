# /opt/mobileshop/.env on the VPS (setup-vps.sh creates it with fresh passwords). Never commit it.
# The address of the app; its DNS A record points to the VPS. HTTPS comes from Traefik.
APP_DOMAIN=app.example.com

POSTGRES_DB=mobileshop
POSTGRES_USER=mobileshop
# generate: openssl rand -hex 24
POSTGRES_PASSWORD=
# generate: openssl rand -hex 32
SECRET_KEY=

WEB_WORKERS=2

# Shops are opened by the product owner (More > Super admin). Keep public signup off.
PUBLIC_SIGNUP=false
# your own login number(s), comma separated, e.g. 03001234567
SUPERUSER_PHONES=

# images built by GitHub Actions (deploy.sh sets IMAGE_TAG per deploy)
IMAGE_PREFIX=ghcr.io/abdurrehmanafzal/mobile-shop

# off-server backup copy (docs/12 "Backups"), e.g. an encrypted rclone remote on Google Drive
RCLONE_REMOTE=
