# Copy to deploy/.env on the VPS and fill in. Never commit deploy/.env.
APP_DOMAIN=app.example.com
ACME_EMAIL=you@example.com

POSTGRES_DB=mobileshop
POSTGRES_USER=mobileshop
# generate: openssl rand -hex 24
POSTGRES_PASSWORD=
# generate: openssl rand -hex 32
SECRET_KEY=

WEB_WORKERS=2

# Shops are opened by the product owner (More > Super admin). Keep public signup off.
PUBLIC_SIGNUP=false
# your own login number(s), comma separated, e.g. 03001234567
SUPERUSER_PHONES=
