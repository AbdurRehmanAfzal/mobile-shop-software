# /opt/mobileshop/.env on the VPS (setup-vps.sh creates it with fresh passwords). Never commit it.
# The address of the app; its DNS A record points to the VPS. HTTPS comes from Traefik.
APP_DOMAIN=app.example.com

POSTGRES_DB=mobileshop
POSTGRES_USER=mobileshop
# generate: openssl rand -hex 24
POSTGRES_PASSWORD=
# generate: openssl rand -hex 32
SECRET_KEY=

WEB_WORKERS=2

# Shops are opened by the product owner (More > Super admin). Keep public signup off.
PUBLIC_SIGNUP=false
# your own login number(s), comma separated, e.g. 03001234567
SUPERUSER_PHONES=

# images built by GitHub Actions (deploy.sh sets IMAGE_TAG per deploy)
IMAGE_PREFIX=ghcr.io/abdurrehmanafzal/mobile-shop

# WhatsApp Cloud API (docs/12 "WhatsApp Business API"); empty = messages are sent by hand
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATES=

# off-server backup copy (docs/12 "Backups"), e.g. an encrypted rclone remote on Google Drive
RCLONE_REMOTE=
# OTP codes go by WhatsApp (needs WHATSAPP_* above). SIGNUP_OTP=true makes public signup prove the number.
SIGNUP_OTP=false
# never true in production: returns the code in the API response for local tests
OTP_DEV_ECHO=false
# Email: any SMTP account (Gmail: smtp.gmail.com, 587, an app password). Empty = emails wait in Messages.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
