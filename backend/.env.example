# Copy to .env. All values optional; defaults are for local development.
APP_ENV=dev
DATABASE_URL=sqlite:///./mobile_shop_v2.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/mobileshop
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
UPLOAD_DIR=./uploads

# Offline renewal codes (docs/19 E): run `python -m app.modules.plan.renewal keygen`, keep the
# private key only on the SaaS server, put the public key here on every install.
RENEWAL_PRIVATE_KEY=
RENEWAL_PUBLIC_KEY=
